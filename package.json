{
  "name": "dashboard-dalduk",
  "version": "1.0.0",
  "description": "Backend service for Dashboard Dalduk built with ElysiaJS, Drizzle ORM, MySQL, and Bun",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.2.0",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.2.14",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.2",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.7.3"
  }
}
